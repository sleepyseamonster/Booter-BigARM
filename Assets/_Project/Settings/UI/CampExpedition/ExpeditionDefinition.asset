    runtimeDefinition: {fileID: 11400000, guid: 73b41c99d8364c5438ea7076e01ca21f, type: 2}
  - id: author.tool.jawbone_salvage_digger
    name: Bone salvage multi-tool
    purpose: A full-length, two-handed bone salvage multi-tool with a broad wedge-shaped
      jawbone head on a stone-bone shaft. The wedge loosens shallow ground and pries
      salvage; the thick hard bony poll on its opposite side provides crude light
      hammering. A fitted shell collar, shell butt cap and iron retaining pin hold
      the simple build together.
    category: Tools
    tier: T0
    rarity: Common
    artName: jawbone-completed-realistic-portrait-v1
