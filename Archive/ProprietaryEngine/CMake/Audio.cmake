add_library(engine_miniaudio STATIC Source/Audio/Miniaudio.c)
target_include_directories(engine_miniaudio SYSTEM PUBLIC "${DEPS}/miniaudio")
find_package(Threads REQUIRED)
target_link_libraries(engine_miniaudio PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
if(APPLE)
    target_link_libraries(engine_miniaudio PRIVATE "-framework CoreFoundation" "-framework CoreAudio" "-framework AudioToolbox")
elseif(WIN32)
    target_link_libraries(engine_miniaudio PRIVATE ole32)
endif()
add_library(engine_audio Source/Audio/Audio.cpp)
target_include_directories(engine_audio PUBLIC Source)
target_link_libraries(engine_audio PRIVATE engine_miniaudio)
