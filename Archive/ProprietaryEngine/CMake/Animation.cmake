# Supply a pinned simdjson target before fastgltf to prevent upstream downloads.
add_library(engine_simdjson STATIC "${DEPS}/simdjson/singleheader/simdjson.cpp")
target_include_directories(engine_simdjson SYSTEM PUBLIC "$<BUILD_INTERFACE:${DEPS}/simdjson/singleheader>" "$<INSTALL_INTERFACE:include>")
install(TARGETS engine_simdjson EXPORT fastgltf-targets ARCHIVE DESTINATION lib EXCLUDE_FROM_ALL)
add_library(simdjson::simdjson ALIAS engine_simdjson)
set(FASTGLTF_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
set(FASTGLTF_ENABLE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(FASTGLTF_COMPILE_AS_CPP20 ON CACHE BOOL "" FORCE)
add_subdirectory("${DEPS}/fastgltf" "${CMAKE_BINARY_DIR}/fastgltf" EXCLUDE_FROM_ALL)
set(ozz_build_tools OFF CACHE BOOL "" FORCE)
set(ozz_build_fbx OFF CACHE BOOL "" FORCE)
set(ozz_build_gltf OFF CACHE BOOL "" FORCE)
set(ozz_build_data OFF CACHE BOOL "" FORCE)
set(ozz_build_samples OFF CACHE BOOL "" FORCE)
set(ozz_build_howtos OFF CACHE BOOL "" FORCE)
set(ozz_build_tests OFF CACHE BOOL "" FORCE)
set(ozz_build_postfix OFF CACHE BOOL "" FORCE)
set(ozz_build_msvc_rt_dll ON CACHE BOOL "" FORCE)
add_subdirectory("${DEPS}/ozz" "${CMAKE_BINARY_DIR}/ozz" EXCLUDE_FROM_ALL)
add_library(engine_animation Source/Animation/Model.cpp Source/Animation/AnimationPlayer.cpp)
target_include_directories(engine_animation PUBLIC Source)
target_link_libraries(engine_animation PUBLIC engine_texture_data PRIVATE ozz_animation ozz_animation_offline)
add_library(engine_model_import Source/Assets/GltfImport.cpp)
target_include_directories(engine_model_import PUBLIC Source)
target_link_libraries(engine_model_import PUBLIC engine_animation PRIVATE fastgltf::fastgltf)
add_executable(engine_model_cook Apps/ModelCooker/main.cpp)
target_link_libraries(engine_model_cook PRIVATE engine_model_import)
