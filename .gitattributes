# Editable Blender sources, including dated recovered saves, use Git LFS.
Docs/Agents/Blender/**/*.blend filter=lfs diff=lfs merge=lfs -text
SourceArt/Blender/**/*.blend filter=lfs diff=lfs merge=lfs -text
Archive/Transfers/Blender/**/*.blend filter=lfs diff=lfs merge=lfs -text

# Acquisition metadata and payload hashes require exact bytes on every platform.
SourceData/** -text
SourceData/**/*.tif filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.npz filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.png filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.jpg filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.zip filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.shp filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.shx filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.dbf filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.raw filter=lfs diff=lfs merge=lfs -text
SourceData/**/*.fbx filter=lfs diff=lfs merge=lfs -text
SourceData/**/proof.json -text -diff
